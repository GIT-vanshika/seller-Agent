# Razorpay AI Buildathon MVP — Environment Configuration Example
# Copy this file to backend/.env and configure your keys.

# 1. Gemini API Credentials (Required for Natural Language Product Q&A & Commercial Negotiation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Razorpay Test Mode Credentials (Required for Authentic Razorpay Checkout Modal & HMAC Verification)
# Obtain from https://dashboard.razorpay.com -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 3. Backend Service Configuration
PORT=8000
ENVIRONMENT=development
